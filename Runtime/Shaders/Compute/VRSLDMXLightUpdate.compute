#pragma kernel UpdateLights
#pragma kernel ValidateChannels
#pragma kernel AdvanceState
#pragma kernel AdvanceStrobe

#include "../Shared/VRSLLightingLibrary.hlsl"

// ── DMX source textures (set by VRSL_URPLightManager) ────────────────────────
Texture2D<float4> _DMXMainTex;
Texture2D<float4> _DMXMovementTex;
Texture2D<float4> _DMXStrobeTex;
Texture2D<float4> _DMXSpinTimerTex;  // SpinnerTimer CRT — accumulates phase as t += dt·rate
// All three textures share the same resolution in VRSL's CRT pipeline
float4 _VRSLDMXTexelSize;   // x=1/w, y=1/h, z=width, w=height

// ── Buffers ───────────────────────────────────────────────────────────────────
StructuredBuffer<VRSLFixtureConfig>   _FixtureConfigs;
RWStructuredBuffer<VRSLLightData>     _LightData;
uint                                   _FixtureCount;
uint                                   _VRSLGoboCount;

// ── DMX channels as bytes ─────────────────────────────────────────────────────
// Set by VRSL_URPLightManager when a channel source is publishing. Channel n
// (1-based, as everywhere else in VRSL) is byte n-1. _VRSLU_DMXChannelCount is 0
// when nothing is publishing, and the reads below fall back to the CRT textures,
// so a scene without a source behaves exactly as it did.
ByteAddressBuffer _VRSLU_DMXChannels;
uint              _VRSLU_DMXChannelCount;

// ── Accumulated state, when the buffer path is driving ────────────────────────
// The SpinnerTimer CRT integrates phase across frames, which a per-frame read of
// the channel buffer cannot reproduce on its own. AdvanceState keeps the same
// integral here, indexed by channel like everything else. It is only meaningful
// while a channel source is publishing; with none, the reads below stay on the
// CRT and the buffer sits untouched.
//
// AdvanceState runs once per frame from the manager, NOT from the render pass.
// The pass dispatches per camera, and an integrator that ran per camera would
// scale its rate with however many cameras a scene has — both eyes in stereo,
// every mirror, every reflection probe.
RWStructuredBuffer<float> _VRSLU_DMXSpinPhase;
float                     _VRSLU_DeltaTime;

// Strobe. The shipped Horizontal and Vertical materials run the CRT's static path,
// which is stateless: phase is _Time.y times one of three fixed frequencies picked
// by DMX thresholds. Only the legacy material integrates. Both are supported here
// because a scene on the legacy material would otherwise silently change rate.
//   _VRSLU_StrobeStatic  1 = static frequencies, 0 = integrate at max frequency
//   _VRSLU_StrobeFreqs   x=low, y=medium, z=high, w=max (dynamic mode only)
RWStructuredBuffer<float> _VRSLU_DMXStrobePhase;
uint                      _VRSLU_StrobeStatic;
float4                    _VRSLU_StrobeFreqs;
float                     _VRSLU_TimeY;
uint                      _VRSLU_StrobeDisabled;

// Point-clamp inline sampler — matches tex2Dlod used in VRSL shader fixtures
SamplerState sampler_point_clamp;

// ── DMX texture sampling ──────────────────────────────────────────────────────
// Direct port of getValueAtCoords() from VRSL-DMXFunctions.cginc.
// Supports IndustryRead (non-Legacy, non-NineUniverse) mode only.
// Channel inputs are uint rather than int because DMX addresses are always
// positive — this lets Metal/SPIR-V use the fast unsigned modulus path
// instead of warning about slow signed modulus.
float GetDMXValue(uint ch, Texture2D<float4> tex)
{
    uint x = ch % 13u;
    if (x == 0u) x = 13u;

    float y = (ch % 13u == 0u) ? (ch / 13.0) - 1.0 : (ch / 13.0);

    // Correction table for channel 13 in specific ranges (matches CGINC exactly)
    if (x == 13u)
    {
        if (ch >= 90u   && ch <= 101u)  y -= 1.0;
        if (ch >= 160u  && ch <= 205u)  y -= 1.0;
        if (ch >= 326u  && ch <= 404u)  y -= 1.0;
        if (ch >= 676u  && ch <= 819u)  y -= 1.0;
        if (ch >= 1339u)                y -= 1.0;
    }

    float resMultX = _VRSLDMXTexelSize.z / 13.0;
    float u = (x  * resMultX * _VRSLDMXTexelSize.x) - 0.015;
    // floor: the Built-in path calls IndustryRead(int x, int y), so the row is
    // truncated to an integer before it is scaled into UV. Porting the call to
    // float dropped that truncation, and the row coordinate then drifted by
    // frac(channel / 13) of a row — enough that every channel past the second in
    // a row sampled the row below it, silently decoding a neighbouring fixture's
    // value. The offsets below are inherited from that path and left alone.
    float v = (floor(y + 1.0) * resMultX * _VRSLDMXTexelSize.y) - 0.001915;

    float4 c = tex.SampleLevel(sampler_point_clamp, float2(saturate(u), saturate(v)), 0);

    // LinearRgbToLuminance — matches CGINC standard (non-NineUniverse) path
    return c.r * 0.2126 + c.g * 0.7152 + c.b * 0.0722;
}

// Channel value straight out of the byte buffer. No coordinate maths, no
// correction table for the 13th channel of a sector, no luminance conversion and
// no layout modes: the channel number is the index. An unpatched or out-of-range
// channel reads 0, which is what an unlit fixture expects.
float LoadDMXChannel(uint ch)
{
    uint index = ch - 1u;
    if (ch == 0u || index >= _VRSLU_DMXChannelCount) return 0.0;
    uint word  = _VRSLU_DMXChannels.Load(index & ~3u);
    uint shift = (index & 3u) * 8u;
    return float((word >> shift) & 0xFFu) * (1.0 / 255.0);
}

// The colour and intensity channels, from whichever source is live. Movement,
// strobe and spin are deliberately not routed here: those textures hold state
// the CRT chain accumulates over time rather than DMX values, so they have no
// equivalent in the channel buffer.
float MainChannel(uint ch)
{
    if (_VRSLU_DMXChannelCount > 0u) return LoadDMXChannel(ch);
    return GetDMXValue(ch, _DMXMainTex);
}

// Raw-channel variant — matches getValueAtCoordsRaw() in VRSL-DMXFunctions.cginc.
// Needed for the SpinnerTimer, whose red channel stores accumulated phase (not a color).
float GetDMXValueRaw(uint ch, Texture2D<float4> tex)
{
    uint x = ch % 13u;
    if (x == 0u) x = 13u;

    float y = (ch % 13u == 0u) ? (ch / 13.0) - 1.0 : (ch / 13.0);

    if (x == 13u)
    {
        if (ch >= 90u   && ch <= 101u)  y -= 1.0;
        if (ch >= 160u  && ch <= 205u)  y -= 1.0;
        if (ch >= 326u  && ch <= 404u)  y -= 1.0;
        if (ch >= 676u  && ch <= 819u)  y -= 1.0;
        if (ch >= 1339u)                y -= 1.0;
    }

    float resMultX = _VRSLDMXTexelSize.z / 13.0;
    float u = (x  * resMultX * _VRSLDMXTexelSize.x) - 0.015;
    // floor: the Built-in path calls IndustryRead(int x, int y), so the row is
    // truncated to an integer before it is scaled into UV. Porting the call to
    // float dropped that truncation, and the row coordinate then drifted by
    // frac(channel / 13) of a row — enough that every channel past the second in
    // a row sampled the row below it, silently decoding a neighbouring fixture's
    // value. The offsets below are inherited from that path and left alone.
    float v = (floor(y + 1.0) * resMultX * _VRSLDMXTexelSize.y) - 0.001915;

    return tex.SampleLevel(sampler_point_clamp, float2(saturate(u), saturate(v)), 0).r;
}

// Accumulated gobo-spin phase for a channel, from whichever source is live.
float SpinPhase(uint ch)
{
    if (_VRSLU_DMXChannelCount > 0u)
    {
        uint index = ch - 1u;
        if (ch == 0u || index >= _VRSLU_DMXChannelCount) return 0.0;
        return _VRSLU_DMXSpinPhase[index];
    }
    return GetDMXValueRaw(ch, _DMXSpinTimerTex);
}

// Strobe multiplier for a channel, from whichever source is live. Mirrors the two
// CRT stages at once: DMXRTShader-StrobeTimings produces the sine phase and
// DMXRTShader-StrobeOutput turns it into the square wave, but that second stage is
// a pure function of phase and the channel value, so it needs no storage.
//
//   square  = sin(phase) > 0 ? 1 : 0
//   below a channel value of 0.2 the fixture is held fully on, not strobed
float StrobeValue(uint ch)
{
    if (_VRSLU_DMXChannelCount == 0u) return GetDMXValue(ch, _DMXStrobeTex);
    if (_VRSLU_StrobeDisabled > 0u)   return 1.0;

    float status = LoadDMXChannel(ch);
    float phase;
    if (_VRSLU_StrobeStatic > 0u)
    {
        float speed = (status > 0.2) ? _VRSLU_StrobeFreqs.y : _VRSLU_StrobeFreqs.x;
        speed       = (status > 0.5) ? _VRSLU_StrobeFreqs.z : speed;
        phase       = _VRSLU_TimeY * speed;
    }
    else
    {
        uint index = ch - 1u;
        phase = (ch == 0u || index >= _VRSLU_DMXChannelCount)
              ? 0.0 : _VRSLU_DMXStrobePhase[index];
    }
    float square = (sin(phase) > 0.0) ? 1.0 : 0.0;
    return (status > 0.2) ? square : 1.0;
}

// ── Rodrigues rotation ────────────────────────────────────────────────────────
float3 RotateAroundAxis(float3 v, float3 axis, float angleDeg)
{
    float rad = radians(angleDeg);
    float c   = cos(rad);
    float s   = sin(rad);
    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0 - c);
}

// ── Kernel: one thread per fixture ───────────────────────────────────────────
[numthreads(64, 1, 1)]
void UpdateLights(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _FixtureCount) return;

    VRSLFixtureConfig cfg = _FixtureConfigs[idx];

    uint absChannel      = (uint)cfg.dmxChannel.x;
    bool enableStrobe    = cfg.dmxChannel.y > 0.5;
    bool enablePanTilt   = cfg.dmxChannel.z > 0.5;
    bool enableFine      = cfg.dmxChannel.w > 0.5;

    // ── DMX channel decode ────────────────────────────────────────────────────
    // Two channel layouts, matching the surface shader's _13CH_MODE / _5CH_MODE:
    //   13-channel: dimmer +5, RGB +7/8/9, strobe +6
    //    5-channel: dimmer +0, RGB +1/2/3, strobe +4 (compressed static layout, for
    //               fixtures patched 5 channels apart). extras.y carries the flag.
    bool fiveCh   = cfg.extras.y > 0.5;
    uint dimmerCh = fiveCh ? absChannel     : absChannel + 5;
    uint rCh      = fiveCh ? absChannel + 1 : absChannel + 7;
    uint gCh      = fiveCh ? absChannel + 2 : absChannel + 8;
    uint bCh      = fiveCh ? absChannel + 3 : absChannel + 9;
    uint strobeCh = fiveCh ? absChannel + 4 : absChannel + 6;

    float intensity = MainChannel(dimmerCh);
    float r = MainChannel(rCh);
    float g = MainChannel(gCh);
    float b = MainChannel(bCh);
    float strobe = 1.0;
    if (enableStrobe)
        strobe = StrobeValue(strobeCh);

    float combinedIntensity =
        intensity * cfg.spotAngles.z * cfg.rightAndMaxIntensity.w * strobe;

    // Match the body-glow surface's dimmer response. GetDMXEmission applies the dimmer
    // twice (colour lerp + final lerp) plus the _CurveMod boost, so the bar emission is
    // ∝ dimmer² × (1 + (curveMod-1)·dimmer). The point light is otherwise linear in the
    // dimmer, which leaves the bar crushed to black at partial dimmer while the spill stays
    // lit. extras.z carries _CurveMod (CPU-synced to the shell material so the two agree).
    // Guard against an unset extras.z (0) — without the floor the factor collapses to
    // intensity*(1-intensity), which is zero at full dimmer and would black the light out.
    //
    // Divided by curveMod so the curve reaches exactly 1 at full dimmer. The shape that
    // tracks the body glow is what matters; the peak gain was incidental, and it made
    // maxIntensity mean "maxIntensity × curveMod" at full DMX — ×2 on the default curve,
    // and twice the output of an AudioLink fixture set to the same value.
    float curveMod = max(cfg.extras.z, 1.0);
    combinedIntensity *= intensity * (1.0 + (curveMod - 1.0) * intensity) / curveMod;

    // ── Direction (pan/tilt for moving heads) ─────────────────────────────────
    float3 baseForward = cfg.forwardAndType.xyz;
    float3 finalDir    = baseForward;

    if (enablePanTilt)
    {
        float maxMinPan  = cfg.panSettings.x;
        float panOffset  = cfg.panSettings.y;
        bool  invertPan  = cfg.panSettings.z > 0.5;

        float maxMinTilt = cfg.tiltSettings.x;
        float tiltOffset = cfg.tiltSettings.y;
        bool  invertTilt = cfg.tiltSettings.z > 0.5;

        // Pan — ch+0 coarse, ch+1 fine
        // Formula matches GetPanValue() in VRSL-DMXFunctions.cginc:
        // Static passes maxMinPan/2 as _MaxMinPanAngle → shader computes
        // (maxMinPan/2 * 2 * raw) - maxMinPan/2 = maxMinPan * raw - maxMinPan/2.
        float panRaw = GetDMXValue(absChannel, _DMXMovementTex);
        if (enableFine) panRaw += GetDMXValue(absChannel + 1, _DMXMovementTex) / 256.0;
        float panDeg = (maxMinPan * panRaw) - (maxMinPan / 2.0) + panOffset;
        if (invertPan) panDeg = -panDeg;

        // Tilt — ch+2 coarse, ch+3 fine (same derivation as pan)
        float tiltRaw = GetDMXValue(absChannel + 2, _DMXMovementTex);
        if (enableFine) tiltRaw += GetDMXValue(absChannel + 3, _DMXMovementTex) / 256.0;
        float tiltDeg = (maxMinTilt * tiltRaw) - (maxMinTilt / 2.0) + tiltOffset;
        if (invertTilt) tiltDeg = -tiltDeg;

        // Matches the volumetric shader: tilt around the fixture's local +X in world
        // space first, then pan around baseForward (object Z). Both axes are supplied
        // from CPU because this kernel has no ObjectToWorld matrix; the supplied axis
        // keeps yawed fixtures (whose local X does not align with world X) rotating
        // about the correct pivot.
        float3 baseRight     = cfg.rightAndMaxIntensity.xyz;
        float3 tiltedForward = RotateAroundAxis(baseForward,   baseRight,   tiltDeg);
        finalDir             = RotateAroundAxis(tiltedForward, baseForward, panDeg);
    }

    // ── Cone width — ch+4 (motor speed / zoom), matches getDMXConeWidth() ────
    // spotAngles.x = inner-to-outer ratio (0..1), spotAngles.y = max outer half-angle,
    // spotAngles.w = min outer half-angle. The inner cone tracks the dynamic outer
    // angle so wash movers stay flat-bright across the cone even as ch+4 zooms it.
    float coneRaw   = MainChannel(absChannel + 4);
    float outerHalf = lerp(cfg.spotAngles.w, cfg.spotAngles.y, coneRaw);
    float innerHalf = outerHalf * cfg.spotAngles.x;

    // ── Spot angle cosines ────────────────────────────────────────────────────
    float innerCos = cos(radians(innerHalf));
    float outerCos = cos(radians(outerHalf));

    // ── Write output ──────────────────────────────────────────────────────────
    VRSLLightData light;
    light.positionAndRange  = float4(cfg.positionAndRange.xyz, cfg.positionAndRange.w);
    // Intensity doubles as the active flag: a fixture that emits nothing is written
    // with zero intensity and the readers skip it. Gating on the dimmer alone leaves a
    // fixture lit when its colour fades to black while the dimmer stays up — the
    // residual near-black RGB is amplified by maxIntensity, and for point lights whose
    // origin sits on the bar mesh by huge near-field attenuation too. Require a
    // non-negligible colour as well: the 6/255 floor clears the fade residual even at
    // high maxIntensity, at the cost of clipping colour dimmer than ~2.4%.
    float colorMax = max(r, max(g, b));
    bool  emitting = combinedIntensity > 0.001 && colorMax > 6.0 / 255.0;
    light.colorAndIntensity = float4(r, g, b, emitting ? combinedIntensity : 0.0);
    // ── Gobo (ch+10 spin speed, ch+11 gobo select) ───────────────────────────
    // Mirrors getDMXGoboSelection() in VRSL-DMXFunctions: round(raw*255/30), clamp 1..N
    // 5-channel fixtures have no gobo/spin channels — those offsets (+10/+11) belong
    // to the next fixture in a 5-apart patch, so suppress the reads in 5CH mode.
    bool  enableGoboSpin = cfg.panSettings.w > 0.5 && !fiveCh;
    bool  enableGobo     = cfg.tiltSettings.w > 0.5 && !fiveCh;
    float spinStatus = MainChannel   (absChannel + 10);                   // DMX value — picks direction
    float spinPhase  = SpinPhase(absChannel + 10);
    float goboRaw    = enableGobo ? MainChannel(absChannel + 11) : 0.0;
    // Mirrors getGoboSpinSpeed() in VRSL-DMXFunctions.cginc: direction is determined
    // by the raw DMX value, magnitude is the integrated phase from SpinnerTimer CRT.
    // The deferred pass uses this directly as radians, matching RotateUV(uv, degrees(·))
    // (degrees/radians wrap cancels inside RotateUV). Wrapping to [-2π, 2π] via fmod
    // bounds precision once the CRT's phase grows after hours of runtime.
    float spinSpeed = 0.0;
    if (enableGoboSpin)
    {
        float angle = (spinStatus > 0.5) ? -spinPhase * 4.0 : spinPhase * 4.0;
        spinSpeed = fmod(angle, 6.28318530718);
    }
    // Gobo projection is a spot-cone effect — SampleGobo masks everything outside the
    // cone and behind the light axis. Point lights are omnidirectional, so leave goboIdx
    // at -1 (the SampleGobo no-op) for them; otherwise their spill is masked down to a
    // narrow gobo'd cone, and zeroed entirely when slot 0 is a patterned gobo.
    // forwardAndType.w < 0.5 == spot.
    int goboIdx = -1;
    if (_VRSLGoboCount > 0 && cfg.forwardAndType.w < 0.5)
    {
        int slot = (int)round(goboRaw * 255.0 / 30.0);
        slot    = clamp(slot, 1, (int)_VRSLGoboCount);
        goboIdx = slot - 1; // convert to 0-based array index
    }

    light.directionAndType = float4(normalize(finalDir),
                                    VRSL_PackTypeAndGobo(cfg.forwardAndType.w, goboIdx));
    light.spotParams       = float4(innerCos, outerCos, cfg.extras.x, spinSpeed);
    _LightData[idx] = light;
}

// ── Accumulated state ─────────────────────────────────────────────────────────
// One thread per channel, dispatched once per frame by the manager while a
// channel source is publishing. Mirrors DMXRTShader-SpinnerTimer's non-nine-
// universe path exactly:
//
//   dmx  = value at this channel
//   dmx < 0.01            -> phase resets to 0, it does not hold
//   spin = dmx > 0.5 ? dmx - 0.5 : dmx    (the upper half is reverse; the
//                                          consumer negates on the same test)
//   phase += dt * spin                    (unbounded; UpdateLights wraps it)
//
// The CRT's one-second warm-up gate has no equivalent here. It existed to let
// the capture chain fill before integrating; a channel source publishes whole
// frames from the first one.
[numthreads(64, 1, 1)]
void AdvanceState(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _VRSLU_DMXChannelCount) return;

    float dmx = LoadDMXChannel(index + 1u);
    if (dmx < 0.01)
    {
        _VRSLU_DMXSpinPhase[index] = 0.0;
        return;
    }
    float spin = (dmx > 0.5) ? (dmx - 0.5) : dmx;
    _VRSLU_DMXSpinPhase[index] += _VRSLU_DeltaTime * spin;
}

// Strobe phase, dynamic mode only. Static mode derives its phase from _Time.y in
// StrobeValue and stores nothing, which is why the shipped Horizontal and Vertical
// materials need no state at all. Mirrors DMXRTShader-StrobeTimings: the delta is
// clamped to 2 seconds so a hitch cannot jump the phase an arbitrary distance, and
// the wrap is a single subtraction, exactly as the CRT does it.
[numthreads(64, 1, 1)]
void AdvanceStrobe(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _VRSLU_DMXChannelCount) return;

    float dmx = LoadDMXChannel(index + 1u);
    float dt  = clamp(_VRSLU_DeltaTime, 0.0, 2.0);
    float t   = _VRSLU_DMXStrobePhase[index] + dt * (dmx * _VRSLU_StrobeFreqs.w);
    t -= (t >= 6.28318530718) ? 6.28318530718 : 0.0;
    _VRSLU_DMXStrobePhase[index] = clamp(t, 0.0, 1000000.0);
}


// ── Validation ────────────────────────────────────────────────────────────────
// Reads channels back through the same accessor the fixtures use, so a readback
// checks the packing and the indexing rather than merely checking that the CPU
// wrote what it meant to. Driven by the editor menu item; costs nothing when it
// is not dispatched.
RWStructuredBuffer<float> _VRSLU_ValidationOut;
uint _VRSLU_ValidationStart;   // 1-based channel of element 0
uint _VRSLU_ValidationCount;

[numthreads(64, 1, 1)]
void ValidateChannels(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VRSLU_ValidationCount) return;
    _VRSLU_ValidationOut[id.x] = LoadDMXChannel(_VRSLU_ValidationStart + id.x);
}
